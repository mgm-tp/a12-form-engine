{
	"version": "0.2",
	"language": "en",
	"ignoreRegExpList": [
		"/from\\s+(['\"])\\S+(['\"])/", // import statements (TS)
		"/import\\s(static\\s)?\\S+/", // import statements (Java, Groovy)
		"/package\\s\\S+/", // package declaration (Java, Groovy)
		"/(include|image)::\\S+/", // asciidoc file/image includes
		"/link:\\S+/", // asciidoc (external) links
		"/<<\\S+(,.*)?>>/", // asciidoc cross-references
		"/:\\S+:\\s\\S+/", // asciidoc attributes (e.g. :sourcedir:})
		"/\\[#\\S+\\]/", // asciidoc section anchors
		"-{4}\n((.|\n)*?)-{4}\n", // asciidoc code blocks
		"/@com\\.mgmtp\\.a12\\.\\S+/", // A12 package names
		"/// nosemgrep:.*/" // comment to disable semgrep rules
	],
	"ignorePaths": [
		"**/*.json",
		"**/*.gradle",
		"**/*.xml",
		"**/*.csv",
		"**/*.yaml",
		"**/*.yml",
		"**/*.patch",
		"**/*.png",
		"**/*.jpg",
		"**/*.svg",
		"**/*.gif",
		"**/*.code-workspace",
		"**/.editorconfig",
		"**/.asciidoctorconfig",
		"**/.gitignore",
		"**/.dockerignore",
		"documentation/scripts/convert.ts",
		"documentation/scripts/asciidoctor.d.ts",
		"documentation/src/assets/typedoc",
		"gradle/*.versions.toml"
	],
	"ignoreWords": [
		"-expandedrow" // part of HTML id
	],
	"words": [
		"actioncontentbox",
		"appsetup",
		"cldr",
		"codemod",
		"codemods",
		"devapp",
		"Drewrite",
		"enablements",
		"formengine",
		"jambit",
		"localizable",
		"localizables",
		"Melies",
		"mgmtp",
		"navigationcontentboxcontext",
		"openrewrite",
		"osgi",
		"Picus",
		"Rsbuild",
		"Rsdoctor",
		"rspack",
		"stylable",
		"typeguard",
		"unmarshall",
		"unmarshalling",
		"worktree"
	],
	"useGitignore": false, // see bug https://github.com/streetsidesoftware/cspell/issues/8012
	"flagWords": [
		"wether->whether"
	]
}
