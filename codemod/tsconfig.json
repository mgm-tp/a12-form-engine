{
	"extends": "@com.mgmtp.a12.devtools/tsconfig",
	"include": ["src"],
	"exclude": ["src/testData"],
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"rootDir": "src",
		"outDir": "lib",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"skipLibCheck": true,
		"resolveJsonModule": true,
		// allow debugging
		"sourceMap": true,
		"erasableSyntaxOnly": true
	}
}
