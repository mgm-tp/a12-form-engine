{
	"extends": "@com.mgmtp.a12.devtools/tsconfig",
	"include": ["./*.ts"],
	"compilerOptions": {
		"types": ["node"],
		"noEmit": true,
		"module": "NodeNext",
		"lib": ["ESNext"],
		"erasableSyntaxOnly": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force"
	}
}
