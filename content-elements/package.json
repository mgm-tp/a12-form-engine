{
  "name": "@com.mgmtp.a12.formengine/formengine-content-elements",
  "version": "38.5.0-SNAPSHOT",
  "description": "Experimental form content elements to be used in content models",
  "author": "mgm technology partners",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf ./lib ./target cyclonedx.json",
    "build": "node --run compile && pnpm \"/^validate:.+/\"",
    "test": "mocha",
    "compile": "pnpm run \"/^compile:.*/\"",
    "compile:cycle-detection": "devtools detect-cycles \"./src/**/*.@(ts|tsx)\" --ignore-type-imports",
    "compile:typescript": "tsc",
    "validate:tsc": "devtools verify-ts-compat ./tsconfig.lib.json -p",
    "validate:api": "api-extractor run --verbose",
    "update:api": "api-extractor run --local",
    "watch": "tsc --project ./tsconfig.dev.json --watch",
    "analyze-component-dependencies": "devtools analyze-dependencies \"./src/main/**/*.@(ts|tsx)\" \"src/main/(?:(core/[^/]+|defaultRender|defaultSetup))/.*\""
  },
  "dependencies": {
    "fast-deep-equal": "catalog:ranges",
    "typescript-fsa": "catalog:"
  },
  "devDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12",
    "@com.mgmtp.a12.client/client-core": "catalog:a12",
    "@com.mgmtp.a12.client/client-data": "catalog:a12",
    "@com.mgmtp.a12.contentengine/contentengine-core": "catalog:a12",
    "@com.mgmtp.a12.devtools/build-tools": "catalog:a12",
    "@com.mgmtp.a12.devtools/tsconfig": "catalog:a12",
    "@com.mgmtp.a12.devtools/eslint-config": "catalog:a12",
    "@com.mgmtp.a12.devtools/prettier-config": "catalog:a12",
    "@com.mgmtp.a12.devtools/react": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-md-facade": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-core-runtime-api-ts": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-localization-react": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-logging": "catalog:a12",
    "@com.mgmtp.a12.widgets/widgets-core": "catalog:a12",
    "@microsoft/api-extractor": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/mocha": "catalog:",
    "@types/react": "catalog:",
    "@types/react-redux": "catalog:",
    "global-jsdom": "catalog:",
    "mocha": "catalog:",
    "react": "catalog:",
    "react-dnd": "catalog:",
    "react-redux": "catalog:",
    "redux": "catalog:",
    "rimraf": "catalog:",
    "source-map-support": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12ranges",
    "@com.mgmtp.a12.client/client-core": "catalog:a12ranges",
    "@com.mgmtp.a12.client/client-data": "catalog:a12ranges",
    "@com.mgmtp.a12.contentengine/contentengine-core": "catalog:a12ranges",
    "@com.mgmtp.a12.kernel/kernel-md-facade": "catalog:a12ranges",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12ranges",
    "@com.mgmtp.a12.utils/utils-localization-react": "catalog:a12ranges",
    "@com.mgmtp.a12.widgets/widgets-core": "catalog:a12ranges",
    "react": "catalog:ranges",
    "react-redux": "catalog:ranges",
    "redux": "catalog:ranges"
  },
  "files": [
    "lib",
    "!lib/test",
    "src",
    "!src/test",
    "cyclonedx.json",
    "NOTICE",
    "THIRD_PARTY_NOTICES",
    "licenses"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts"
}
