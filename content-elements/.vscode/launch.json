{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Debug Tests",
			"program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
			"args": [
				"--config=./.mocharc.json",
				"--reporter=spec",
				"--forbid-only=false",
				"--colors",
				"--timeout=0"
			],
			"resolveSourceMapLocations": [
				"${workspaceFolder}/lib/**",
				"${workspaceFolder}/../node_modules/.pnpm/@com.mgmtp.a12*/**"
			]
		},
		{
			// this config is used by Mocha Test Explorer (when running tests via sidebar)
			"type": "node",
			"request": "attach",
			"name": "mocha-explorer-debug-config",
			"continueOnAttach": true,
			"resolveSourceMapLocations": [
				"${workspaceFolder}/lib/**",
				"${workspaceFolder}/../node_modules/.pnpm/@com.mgmtp.a12*/**"
			]
		}
	]
}
