                    "name": "explanation",
                    "content": {
                      "text": [
                        {
                          "locale": "en",
                          "text": "This model shows the old responsive behavior of the layout grid.\n<br/>\nWhen the horizontal space gets smaller, the cell size and wrapping behaves in a certain way. In the past this behavior was determined by a lookup table. \n<br/>\nIn this model the behavior was \"baked\" into the model by writing the lookup table results into the grid layout configuration.\n<br/>\nThis can also be achived during the migration from form model version 30.0.0 to 31.0.0."
                        }
                      ]
                    }
                  }
                ]
