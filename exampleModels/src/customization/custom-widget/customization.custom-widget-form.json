                    "id": "textcell-fa912",
                    "name": "textDatePicker",
                    "content": {
                      "text": [
                        {
                          "locale": "en",
                          "text": "The date picker of this date input has been restricted to the next 14 days.<br/>\nThis can be done by adding the property <i>disabledDays</i> to the <i>Datepicker</i> properties and specifying the desired range of days."
                        }
                      ]
                    }
                  }
                ]
