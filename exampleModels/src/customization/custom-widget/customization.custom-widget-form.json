                  {
                    "type": "TextCell",
                    "id": "textcell-a5c6f",
                    "name": "textClearButton",
                    "content": {
                      "text": [
                        {
                          "locale": "en",
                          "text": "This text line contains a custom clear button.<br/>\nThis can be achieved by connecting the <i>TextLineStateless</i> widget to the  Redux store and adding a button to the <i>suffixes</i> property.<br/>\nThis button dispatches an action to set the corresponding value in the document to <i>null</i>."
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "type": "Row",
                "id": "row-7a457",
                "cell": [
