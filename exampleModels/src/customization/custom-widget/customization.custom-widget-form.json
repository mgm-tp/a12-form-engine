                "cell": [
                  {
                    "type": "TextCell",
                    "id": "textcell-32084",
                    "name": "textIntroduction",
                    "content": {
                      "text": [
                        {
                          "locale": "en",
                          "text": "This is an example of how to customize widgets by providing your own widget map.<br/>\nThe map has to defined in custom code and is then registered in the Form Engine Config through the property <i>widgetMap</i>.<br/>\nThe code for creating the map can be found here: <i>devapp\\src\\customizations\\custom-widgets.tsx</i><br/><br/>\nThe control grid and controls, that contain custom widgets, were assigned special annotations in the form model.<br/>\nThese annotations are then used in the custom widget map to determine, if the customization should be applied to this instance of the widget or not."
                        }
                      ]
                    }
                  }
                ]
              }
            ],
            "verticalAlignment": "TOP"
          },
          {
            "type": "ControlGrid",
            "id": "controlgrid-8baf0",
            "name": "cg",
            "title": {
              "type": "Multilingual",
              "multilingualText": {
                "text": [
                  {
                    "locale": "en",
                    "text": "Control-Grid with tooltip in title"
                  }
                ]
              }
            },
            "annotations": [
              {
                "name": "tooltip",
                "value": "Today is the:"
              }
            ],
            "row": [
              {
                "type": "Row",
                "id": "row-0e5c9",
                "cell": [
                  {
                    "type": "TextCell",
                    "id": "textcell-f205e",
                    "name": "textControlGrid",
                    "content": {
                      "text": [
                        {
                          "locale": "en",
                          "text": "This control grid contains an additional tooltip in its title.<br/>\nThe tooltip is added by customizing the <i>addons</i> property of the <i>Typography.Headline</i>"
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "type": "Row",
                "id": "row-b8424",
                "cell": [
                  {
                    "type": "Control",
                    "id": "control-9023d",
                    "annotations": [
                      {
                        "name": "showHelpText"
                      }
                    ],
                    "elementRef": "field_057ab"
                  }
                ]
              },
              {
                "type": "Row",
                "id": "row-ed319",
                "cell": [
                  {
                    "type": "TextCell",
                    "id": "textcell-9183a",
                    "name": "textHelperText",
                    "content": {
                      "text": [
                        {
                          "locale": "en",
                          "text": "This text line was customized by adding an additional button to the tooltips, that opens a modal dialog with a helper text.<br/>\nThis is achieved by adding this button the <i>addonAfter</i> property of the <i>TextLineStateless</i> widget."
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "type": "Row",
                "id": "row-360c7",
                "cell": [
                  {
                    "type": "Control",
                    "id": "control-9dc63",
                    "annotations": [
                      {
                        "name": "showClearButton"
                      }
