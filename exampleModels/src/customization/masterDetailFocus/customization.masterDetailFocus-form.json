                        "content": {
                          "text": [
                            {
                              "locale": "en",
                              "text": "Adjust the fields below to explore the resulting focus timing race. While \"open-detail\" is reopening an already-open detail (see the countdown below), the button is disabled, but the fields stay editable - any changes made during that wait only take effect on the *next* \"open-detail\" click, not the one already in progress."
                            }
