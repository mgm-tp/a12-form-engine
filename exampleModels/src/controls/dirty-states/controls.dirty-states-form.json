        "screenElements": [
          {
            "type": "Section",
            "id": "section-87627",
            "name": "description",
            "title": {
              "type": "Multilingual",
              "multilingualText": {
                "text": [
                  {
                    "locale": "en",
                    "text": "This demonstration model shows how the two dirty states work."
                  }
                ]
              }
            },
            "collapsible": true,
            "initiallyCollapsed": true,
            "screenElements": [
              {
                "type": "ControlGrid",
                "id": "controlgrid-89e65",
                "name": "grid",
                "row": [
                  {
                    "type": "Row",
                    "id": "row-ba97e",
                    "cell": [
                      {
                        "type": "TextCell",
                        "id": "textcell-7d26a",
                        "name": "text",
                        "content": {
                          "text": [
                            {
                              "locale": "en",
                              "text": "The store contains two dirty states that are used for the data and UI state of the entire form. The default behavior of both states is that both are initialized with false and can only turn true.\nThe data dirty state will turn true if a value changes on a top-level screen or when changes on a detached repeat detail-screen are committed. It will not return to false on backup restoring.\nDetached repeat detail-screens have their own data dirty state, which only applies to this screen. It is initialized with undefined and will turn true, if a value changes on the corresponding detail-screen or when changes on a nested detached repeat detail-screen are committed.\nThe ui dirty state will turn true if a conversion error occurred and will not return to false if this error is resolved. In addition if \"earlyDetectDirtyControl\" is enabled and some value is changed but not submitted, the ui dirty state will also turn true."
                            }
                          ]
                        }
                      }
                    ]
                  }
                ],
                "verticalAlignment": "BOTTOM"
              }
            ]
