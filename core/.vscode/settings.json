{
	"[asciidoc][markdown]": {
		"editor.quickSuggestions": {
			"comments": "off",
			"strings": "off",
			"other": "off"
		},
		"editor.wordWrap": "wordWrapColumn",
		"editor.wordWrapColumn": 80
	},
	"editor.parameterHints.enabled": true,
	"editor.rulers": [80, 120],
	"path-intellisense.extensionOnImport": false,
	"testExplorer.mergeSuites": true,
	"js/ts.validate.enabled": true,
	"js/ts.preferences.importModuleSpecifierEnding": "js",
	"js/ts.tsdk.path": "./node_modules/typescript/lib",
	"[javascript]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescript]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescriptreact]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[jsonc]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"editor.codeActionsOnSave": {
		"source.fixAll.oxc": "explicit"
	},
	"mochaExplorer.logpanel": true,
	"mochaExplorer.globImplementation": "vscode",
	// custom config to be able to use source maps from node_modules
	"mochaExplorer.debuggerConfig": "mocha-explorer-debug-config",
	// prevent timeout errors during debugging
	"mochaExplorer.timeout": 0
}
