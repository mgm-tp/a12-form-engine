{
  "name": "@com.mgmtp.a12.formengine/formengine-core",
  "version": "39.0.0",
  "description": "Form-Engine",
  "author": "mgm technology partners",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./lib/index.js",
    "./a12internal": "./lib/client-extensions/internal/extensions/form-engine/internal/engineMiddlewareAdapterFactory.js"
  },
  "scripts": {
    "clean": "rimraf ./lib ./target cyclonedx.json",
    "build": "node --run compile && node --run typedoc && pnpm \"/^validate:.+/\"",
    "compile": "node --run copyJison && pnpm \"/^compile:.+/\"",
    "copyJison": "node ./scripts/initialize/jison.js",
    "compile:typescript": "tsc",
    "compile:detect-cycles": "devtools detect-cycles \"./src/**/*.@(ts|tsx|d.ts|d.cts|d.mts)\" --ignore-type-imports",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . --cache",
    "lint:fix": "node --run lint -- --fix",
    "lint:onlyErrors": "node --run lint -- --quiet",
    "validate:tsc": "devtools verify-ts-compat ./tsconfig.lib.json -p",
    "validate:api": "api-extractor run --verbose",
    "update:api": "api-extractor run --local",
    "test": "node --run mocha",
    "test:coverage": "c8 node --run mocha",
    "typedoc": "typedoc",
    "typescript": "tsc --project ./tsconfig.dev.json",
    "watch": "tsc --project ./tsconfig.dev.json --watch",
    "mocha": "node --expose-gc --max-old-space-size=2048 scripts/mocha/runner.js -i \"./lib/test/**/*.@(test|spec).js\"",
    "dev:mocha": "node --expose-gc --max-old-space-size=2048 scripts/mocha/runner.js --reporter=.mocha-dev-reporter.json",
    "dev:unused-exports": "ts-unused-exports ./tsconfig.json $(find ./src/test -name *.ts -or -name *.tsx)"
  },
  "dependencies": {
    "@com.mgmtp.a12.client/typescript-fsa-redux-5-compat": "catalog:a12ranges",
    "dompurify": "catalog:ranges",
    "fast-deep-equal": "catalog:ranges",
    "fp-ts": "catalog:ranges"
  },
  "devDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12",
