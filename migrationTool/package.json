{
  "name": "@com.mgmtp.a12.formengine/formengine-model-migration",
  "version": "39.1.1",
  "description": "form model migration CLI tool",
  "author": "mgm technology partners",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "type": "module",
  "scripts": {
    "clean": "git clean -fdX -- target lib cyclonedx.json",
    "build": "node --run compile",
    "compile": "pnpm run \"/^compile:[a-z]*$/\"",
    "compile:typescript": "migration-tool-utils compile",
    "test:coverage": "c8 mocha",
    "test": "mocha",
    "typescript": "tsc --project ./tsconfig.dev.json",
    "watch": "tsc --project ./tsconfig.dev.json --watch",
    "lint": "pnpm -w exec oxlint migrationTool",
    "lint:fix": "pnpm -w exec oxlint --fix migrationTool",
    "lint:onlyErrors": "pnpm -w exec oxlint --quiet migrationTool"
  },
  "bin": "lib/main/cli.js",
  "devDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12",
    "@com.mgmtp.a12.devtools/tsconfig": "catalog:a12",
    "@com.mgmtp.a12.migrationtool/migrationtool-utils": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "mocha": "catalog:",
    "c8": "catalog:",
    "source-map-support": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@com.mgmtp.a12.migrationtool/migrationtool-core": "catalog:a12"
  },
  "files": [
    "lib",
    "!lib/test",
    "src",
    "!src/test",
    "cyclonedx.json",
    "NOTICE",
    "THIRD_PARTY_NOTICES",
    "licenses"
  ],
  "exports": "./lib/main/api.js"
}
