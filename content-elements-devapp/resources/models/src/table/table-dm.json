                  ]
                }
              },
              {
                "type": "Rule",
                "id": "rule_0328b",
                "name": "AtLeastOneEntryShoppingList",
                "Rule": {
                  "errorEntityRelPath": "../shoppingList/item",
                  "errorCode": "Error rule_0328b",
                  "errorCondition": "NoGroupFilled(shoppingList*)",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "At least one shopping list entry needed!"
                    }
                  ]
                }
              },
              {
                "type": "Rule",
                "id": "rule_fb028",
                "name": "MaxAmountEntriesShoppingList",
                "Rule": {
                  "errorEntityRelPath": "../shoppingList/item",
                  "errorCode": "Error rule_fb028",
                  "errorCondition": "NumberOfFilledGroups(shoppingList*) > 5",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "Only 5 entries allowed!"
                    }
                  ]
                }
              },
              {
                "type": "Rule",
                "id": "rule_192b6",
                "name": "MaxAmountPerItemRule",
                "Rule": {
                  "errorEntityRelPath": "../shoppingList/amount",
                  "errorCode": "Error rule_192b6",
                  "errorCondition": "FieldFilled(shoppingList/amount) AND [shoppingList/amount] > 50",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "The amount cannot be greater than 50!"
                    }
                  ]
                }
              },
              {
                "type": "Rule",
                "id": "rule_c33ed",
                "name": "IfItemThenAmountRule",
                "Rule": {
                  "errorEntityRelPath": "../shoppingList/amount",
                  "errorCode": "Error rule_c33ed",
                  "errorCondition": "FieldFilled(shoppingList/item) And FieldNotFilled(shoppingList/amount)",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "If you have an item you need to declare an amount!"
                    }
                  ]
                }
              },
              {
                "type": "Rule",
                "id": "rule_d33ee",
                "name": "MaxAmountSumItemRule",
                "Rule": {
                  "errorEntityRelPath": "../shoppingList/amount",
                  "errorCode": "Error rule_d33ee",
                  "errorCondition": "Sum(shoppingList*/amount) > 75",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "The overall amount of items cannot exceed 75!"
                    }
                  ]
                }
              }
            ]
          }
