{
  "name": "content-elements-devapp",
  "version": "39.0.0",
  "description": "Devapp for form content elements",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf ./lib ./target",
    "build": "node --run compile",
    "compile": "pnpm run \"/^compile:.*/\"",
    "compile:typescript": "tsc",
    "compile:cycle-detection": "devtools detect-cycles \"./src/**/*.@(ts|tsx|d.ts|d.cts|d.mts)\"",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . --cache",
    "lint:fix": "node --run lint -- --fix",
    "lint:onlyErrors": "node --run lint -- --quiet",
    "watch": "tsc --watch",
    "start": "node --run start:mock",
    "start:mock": "rsbuild dev -c rsbuild/rsbuild.config.ts --env-mode mock",
    "analyze": "rsbuild build --env-mode analyze -c rsbuild/rsbuild.config.ts",
    "preview": "rsbuild preview -c rsbuild/rsbuild.config.ts"
  },
  "author": "mgm technology partners",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "devDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12",
    "@com.mgmtp.a12.client/client-core": "catalog:a12",
    "@com.mgmtp.a12.client/client-data": "catalog:a12",
    "@com.mgmtp.a12.client/typescript-fsa-redux-5-compat": "catalog:a12",
    "@com.mgmtp.a12.contentengine/contentengine-core": "catalog:a12",
    "@com.mgmtp.a12.contentengine/contentengine-default-element-library": "catalog:a12",
    "@com.mgmtp.a12.contentengine/contentengine-editor": "catalog:a12",
    "@com.mgmtp.a12.dataservices/dataservices-access": "catalog:a12",
    "@com.mgmtp.a12.devtools/build-tools": "catalog:a12",
    "@com.mgmtp.a12.devtools/tsconfig": "catalog:a12",
    "@com.mgmtp.a12.formengine/formengine-content-elements": "workspace:*",
    "@com.mgmtp.a12.formengine/formengine-content-elements-editor": "workspace:*",
    "@com.mgmtp.a12.kernel/kernel-core-runtime-api-ts": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-md-facade": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-connector": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-localization-react": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-logging": "catalog:a12",
    "@com.mgmtp.a12.widgets/widgets-core": "catalog:a12",
    "@redux-devtools/extension": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@rsdoctor/rspack-plugin": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "date-fns": "catalog:",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "react": "catalog:",
    "react-dnd": "catalog:",
    "react-dom": "catalog:",
