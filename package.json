{
  "name": "@com.mgmtp.a12.formengine/root",
  "version": "39.0.0",
  "a12ReleaseLine": "2026.06",
  "description": "Form Engine Workspaces Root",
  "author": "mgm technology partners",
  "type": "module",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "engines": {
    "node": "^24",
    "pnpm": "^11"
  },
  "private": true,
  "scripts": {
    "postinstall": "node ./scripts/validateA12Peers.ts",
    "clean": "pnpm run -r --parallel clean",
    "verify": "pnpm run \"/^(format|lint:onlyErrors|spellcheck)$/\"",
    "verify:fix": "pnpm run \"/^(format:fix|lint:fix)$/\"",
    "build": "pnpm run -r build",
    "compile": "pnpm run -r compile",
    "watch": "pnpm run -r --parallel watch",
    "test": "pnpm run -r --filter=!@com.mgmtp.a12.formengine/formengine-content-elements --filter=!@com.mgmtp.a12.formengine/formengine-content-elements-editor test",
    "start": "pnpm run -r start",
    "format": "prettier \"**/src/**/*.{ts,tsx}\" \"*.ts\" --check --experimental-cli --parallel-workers 2",
    "format:fix": "prettier \"**/src/**/*.{ts,tsx}\" \"*.ts\" --write --experimental-cli --parallel-workers 2",
    "lint:root": "eslint --flag unstable_native_nodejs_ts_config -c eslint.root.config.ts . --cache",
    "lint": "pnpm run -r --sequential lint && node --run lint:root",
    "lint:fix": "pnpm run -r --sequential lint:fix && node --run lint:root -- --fix",
    "lint:onlyErrors": "pnpm run -r --sequential lint:onlyErrors && node --run lint:root -- --quiet",
    "lint:inspect": "pnpm dlx @eslint/config-inspector",
    "spellcheck": "pnpm run -r --parallel spellcheck",
    "validate:api": "pnpm run -r --parallel validate:api",
    "update:api": "pnpm run -r --parallel update:api"
  },
  "devDependencies": {
    "@com.mgmtp.a12.devtools/eslint-config": "catalog:a12",
    "@com.mgmtp.a12.devtools/prettier-config": "catalog:a12",
    "@eslint/compat": "catalog:",
    "@jambit/eslint-plugin-typed-redux-saga": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-mocha": "catalog:",
    "eslint-plugin-notice": "catalog:",
    "eslint-plugin-use-effect-no-deps": "catalog:",
    "eslint-plugin-workspaces": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "semver": "catalog:",
    "smol-toml": "catalog:",
    "yaml": "catalog:"
  },
  "packageManager": "pnpm@11.3.0"
}
