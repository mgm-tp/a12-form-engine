{
  "header": {
    "id": "ProductDomain",
    "modelType": "document",
    "modelVersion": "29.4.0",
    "locales": [
      {
        "code": "en"
      }
    ],
    "labels": [],
    "annotations": [],
    "modelReferences": []
  },
  "content": {
    "modelInfo": {
      "name": "ProductDomain",
      "immutable": false,
      "comment": "This is a sample product model for a commerce PIM."
    },
    "modelConfig": {
      "decimalSeparator": ".",
      "timeZone": "UTC",
      "conditionLanguage": {
        "code": "en_US"
      }
    },
    "modelRoot": {
      "rootGroups": [
        {
          "type": "Group",
          "id": "G2",
          "name": "product",
          "Group": {
            "repeatability": 1,
            "elements": [
              {
                "type": "Field",
                "id": "F3",
                "name": "number",
                "internalDescription": [
                  {
                    "locale": "en",
                    "text": "The unique business identifier of the product."
                  }
                ],
                "Field": {
                  "fieldType": {
                    "type": "StringType"
                  },
                  "requirednessConfig": {
                    "mode": "absoluteOrRelativeToNextRepAncestor"
                  }
                }
              },
              {
                "type": "Group",
                "id": "G4",
                "name": "externalNumber",
                "internalDescription": [
                  {
                    "locale": "en",
                    "text": "A list of numbers identifying the product uniquely in external systems."
                  }
                ],
                "Group": {
                  "repeatability": 100,
                  "elements": [
                    {
                      "type": "Field",
                      "id": "F5",
                      "name": "system",
                      "internalDescription": [
                        {
                          "locale": "en",
                          "text": "A transformation to the external system using this number."
                        }
                      ],
                      "Field": {
                        "fieldType": {
                          "type": "StringType"
                        },
                        "requirednessConfig": {
                          "mode": "absoluteOrRelativeToNextRepAncestor"
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "F6",
                      "name": "number",
                      "internalDescription": [
                        {
                          "locale": "en",
                          "text": "The number used by this external system."
                        }
                      ],
                      "Field": {
                        "fieldType": {
                          "type": "StringType"
                        },
                        "requirednessConfig": {
                          "mode": "absoluteOrRelativeToNextRepAncestor"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "Field",
                "id": "F7",
                "name": "name",
                "internalDescription": [
                  {
                    "locale": "en",
                    "text": "A rather short name of the product, which can be displayed in product lists, invoices,\n\t\t\t\t\tetc."
                  }
                ],
                "Field": {
                  "fieldType": {
                    "type": "StringType",
                    "StringType": {
                      "minLength": 3,
                      "maxLength": 256
                    }
                  },
                  "requirednessConfig": {
                    "mode": "absoluteOrRelativeToNextRepAncestor"
                  }
                }
              },
              {
                "type": "Field",
                "id": "F8",
                "name": "description",
                "internalDescription": [
                  {
                    "locale": "en",
                    "text": "A transformation to the brand of this product."
                  }
                ],
                "Field": {
                  "fieldType": {
                    "type": "StringType",
                    "StringType": {
                      "lineBreaksPermitted": true
                    }
                  },
                  "requirednessConfig": {
                    "mode": "absoluteOrRelativeToNextRepAncestor"
                  }
                }
              },
              {
                "type": "Field",
                "id": "F9",
                "name": "metaDescription",
                "internalDescription": [
                  {
                    "locale": "en",
                    "text": "For the HTML meta tag description."
                  }
                ],
                "Field": {
                  "fieldType": {
                    "type": "StringType"
                  }
                }
              },
              {
                "type": "Group",
                "id": "G10",
                "name": "searchKeywords",
                "internalDescription": [
                  {
                    "locale": "en",
                    "text": "A list of keywords for site search boosting."
                  }
                ],
                "Group": {
                  "repeatability": 1,
                  "elements": [
                    {
                      "type": "Field",
                      "id": "F11",
                      "name": "searchKeyword",
                      "internalDescription": [
                        {
                          "locale": "en",
                          "text": "A list of keywords for site search boosting. The entry of keywords is supported\n\t\t\t\t\t\tsuing keyword prediction."
                        }
                      ],
                      "Field": {
                        "fieldType": {
                          "type": "StringType"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "Group",
                "id": "G17",
                "name": "mediaFiles",
                "internalDescription": [
                  {
                    "locale": "en",
                    "text": "A list of media files, which are imported or uploaded for this particular product."
                  }
                ],
                "Group": {
                  "repeatability": 100,
                  "elements": [
                    {
                      "type": "Group",
                      "id": "G18",
                      "name": "mediaFile",
                      "internalDescription": [
                        {
                          "locale": "en",
                          "text": "One media file with…"
                        }
                      ],
                      "Group": {
                        "repeatability": 1,
                        "elements": [
                          {
                            "type": "Field",
                            "id": "F19",
                            "name": "type",
                            "internalDescription": [
                              {
                                "locale": "en",
                                "text": "a type, e.g. image, video, document, etc."
                              }
                            ],
                            "Field": {
                              "fieldType": {
                                "type": "StringType"
                              },
                              "requirednessConfig": {
                                "mode": "absoluteOrRelativeToNextRepAncestor"
                              }
                            }
                          },
                          {
                            "type": "Field",
                            "id": "F21",
                            "name": "mimeType",
                            "internalDescription": [
                              {
                                "locale": "en",
                                "text": "a mime type, e.g. image/jpeg, video/mp4, application/pdf, …"
                              }
                            ],
                            "Field": {
                              "fieldType": {
                                "type": "StringType"
                              },
                              "requirednessConfig": {
                                "mode": "absoluteOrRelativeToNextRepAncestor"
                              }
                            }
                          },
                          {
                            "type": "Field",
                            "id": "F22",
                            "name": "url",
                            "internalDescription": [
                              {
                                "locale": "en",
                                "text": "an absolute or relative path and/or file name. The interpretation depends on the\n\t\t\t\t\t\t\tdigital asset management solution."
                              }
                            ],
                            "Field": {
                              "fieldType": {
                                "type": "StringType"
                              },
                              "requirednessConfig": {
                                "mode": "absoluteOrRelativeToNextRepAncestor"
                              }
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "type": "Group",
                "id": "G13",
                "name": "logistics",
                "Group": {
                  "repeatability": 1,
                  "elements": [
                    {
                      "type": "Group",
                      "id": "G14",
                      "name": "weight",
                      "Group": {
                        "repeatability": 1,
                        "elements": [
                          {
                            "type": "Field",
                            "id": "F15",
                            "name": "weightValue",
                            "internalDescription": [
                              {
                                "locale": "en",
                                "text": "The weight of the product."
                              }
                            ],
                            "Field": {
                              "fieldType": {
                                "type": "NumberType",
                                "NumberType": {
                                  "maxFractionalDigits": 4
                                }
                              },
                              "requirednessConfig": {
                                "mode": "absoluteOrRelativeToNextRepAncestor"
                              }
                            }
                          },
                          {
                            "type": "Field",
                            "id": "F16",
                            "name": "weightUnit",
                            "internalDescription": [
                              {
                                "locale": "en",
                                "text": "The unit, in which the weight is measured."
                              }
                            ],
                            "Field": {
                              "fieldType": {
                                "type": "StringType"
                              },
                              "requirednessConfig": {
                                "mode": "absoluteOrRelativeToNextRepAncestor"
                              }
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "type": "Group",
                "id": "G23",
                "name": "packaging",
                "Group": {
                  "repeatability": 1,
                  "elements": [
                    {
                      "type": "Field",
                      "id": "F24",
                      "name": "packagingMultiplicator",
                      "internalDescription": [
                        {
                          "locale": "en",
                          "text": "The number of sub items in the product, e.g. the number of bottles in a box of\n\t\t\t\t\t\twine."
                        }
                      ],
                      "Field": {
                        "fieldType": {
                          "type": "NumberType"
                        },
                        "requirednessConfig": {
                          "mode": "absoluteOrRelativeToNextRepAncestor"
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "F25",
                      "name": "packagingAmount",
                      "internalDescription": [
                        {
                          "locale": "en",
                          "text": "The amount of content in one sub item of the product, e.g. 0.75 in case of a wine\n\t\t\t\t\t\tbottle."
                        }
                      ],
                      "Field": {
                        "fieldType": {
                          "type": "NumberType",
                          "NumberType": {
                            "minFractionalDigits": 2,
                            "maxFractionalDigits": 3
                          }
                        },
                        "requirednessConfig": {
                          "mode": "absoluteOrRelativeToNextRepAncestor"
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "F26",
                      "name": "packagingUnit",
                      "internalDescription": [
                        {
                          "locale": "en",
                          "text": "The unit, in which the packagingAmount is measured, e.g. liter."
                        }
                      ],
                      "Field": {
                        "fieldType": {
                          "type": "StringType"
                        },
                        "requirednessConfig": {
                          "mode": "absoluteOrRelativeToNextRepAncestor"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "Field",
                "id": "F27",
                "name": "eatable",
                "Field": {
                  "fieldType": {
                    "type": "BooleanType"
                  }
                }
              },
              {
                "type": "Field",
                "id": "F28",
                "name": "sizeCategory",
                "Field": {
                  "fieldType": {
                    "type": "EnumerationType",
                    "EnumerationType": {
                      "values": [
                        {
                          "value": "large",
                          "label": [
                            {
                              "locale": "en",
                              "text": "Large"
                            }
                          ]
                        },
                        {
                          "value": "medium",
                          "label": [
                            {
                              "locale": "en",
                              "text": "Medium"
                            }
                          ]
                        },
                        {
                          "value": "small",
                          "label": [
                            {
                              "locale": "en",
                              "text": "Small"
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              },
              {
                "type": "Field",
                "id": "F29",
                "name": "transportVehicle",
                "Field": {
                  "fieldType": {
                    "type": "EnumerationType",
                    "EnumerationType": {
                      "values": [
                        {
                          "value": "big",
                          "label": [
                            {
                              "locale": "en",
                              "text": "big vehicle"
                            }
                          ]
                        },
                        {
                          "value": "small",
                          "label": [
                            {
                              "locale": "en",
                              "text": "small vehicle"
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              },
              {
                "type": "Group",
                "id": "group_b7007",
                "name": "multiSelectField",
                "Group": {
                  "repeatability": 999999,
                  "usageType": "multi-select",
                  "elements": [
                    {
                      "type": "Field",
                      "id": "field_f866d",
                      "name": "value",
                      "Field": {
                        "fieldType": {
                          "type": "EnumerationType",
                          "EnumerationType": {
                            "values": [
                              {
                                "value": "1",
                                "label": []
                              },
                              {
                                "value": "2",
                                "label": []
                              },
                              {
                                "value": "3",
                                "label": []
                              }
                            ]
                          }
                        },
                        "requirednessConfig": {
                          "mode": "absoluteOrRelativeToNextRepAncestor"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "Group",
                "id": "G24",
                "name": "stringValueMultiSelectField",
                "Group": {
                  "repeatability": 999999,
                  "usageType": "multi-select",
                  "elements": [
                    {
                      "type": "Field",
                      "id": "F30",
                      "name": "value",
                      "Field": {
                        "fieldType": {
                          "type": "StringType"
                        },
                        "requirednessConfig": {
                          "mode": "absoluteOrRelativeToNextRepAncestor"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "Group",
                "id": "group_fe518",
                "name": "attachment",
                "Group": {
                  "repeatability": 1,
                  "usageType": "attachment",
                  "elements": [
                    {
                      "type": "Field",
                      "id": "field_dffa7",
                      "name": "original_filename",
                      "Field": {
                        "fieldType": {
                          "type": "StringType"
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "field_592b2",
                      "name": "internal_filename",
                      "Field": {
                        "fieldType": {
                          "type": "StringType"
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "field_32e93",
                      "name": "content",
                      "Field": {
                        "fieldType": {
                          "type": "StringType",
                          "StringType": {
                            "lineBreaksPermitted": true,
                            "noValueValidation": true
                          }
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "field_181fc",
                      "name": "attachment_id",
                      "Field": {
                        "fieldType": {
                          "type": "StringType"
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "field_2925e",
                      "name": "size",
                      "Field": {
                        "fieldType": {
                          "type": "NumberType"
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "field_97bab",
                      "name": "mime_type",
                      "Field": {
                        "fieldType": {
                          "type": "StringType"
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "field_30eb8",
                      "name": "category",
                      "Field": {
                        "fieldType": {
                          "type": "StringType"
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "field_9d2b4",
                      "name": "description",
                      "Field": {
                        "fieldType": {
                          "type": "StringType"
                        }
                      }
                    },
                    {
                      "type": "Rule",
                      "id": "rule_e6e72",
                      "name": "AttachmentInternalFilenameRequired",
                      "Rule": {
                        "errorEntityRelPath": "../internal_filename",
                        "errorCode": "Errorrule_e6e72",
                        "errorCondition": "GroupFilled(RuleGroup) and FieldNotFilled(internal_filename)",
                        "severity": "ERROR",
                        "errorMessage": [
                          {
                            "locale": "en",
                            "text": "Internal Error: Field $internal_filename$ of customType attachment is not filled."
                          }
                        ]
                      }
                    },
                    {
                      "type": "Rule",
                      "id": "rule_691d5",
                      "name": "AttachmentMimeTypeRequired",
                      "Rule": {
                        "errorEntityRelPath": "../mime_type",
                        "errorCode": "Errorrule_691d5",
                        "errorCondition": "GroupFilled(RuleGroup) and FieldNotFilled(mime_type)",
                        "severity": "ERROR",
                        "errorMessage": [
                          {
                            "locale": "en",
                            "text": "Internal Error: Field $mime_type$ of customType attachment is not filled."
                          }
                        ]
                      }
                    },
                    {
                      "type": "Rule",
                      "id": "rule_96524",
                      "name": "AttachmentIdOrContentFilled",
                      "Rule": {
                        "errorEntityRelPath": "../content",
                        "errorCode": "Errorrule_96524",
                        "errorCondition": "GroupFilled(RuleGroup) and NotExactlyOneFieldFilled(attachment_id, content)",
                        "severity": "ERROR",
                        "errorMessage": [
                          {
                            "locale": "en",
                            "text": "Internal Error: Either attachment_id or content must be filled in a customType attachment, but not both."
                          }
                        ]
                      }
                    },
                    {
                      "type": "Rule",
                      "id": "rule_888ef",
                      "name": "SizeOfContentFilled",
                      "Rule": {
                        "errorEntityRelPath": "../content",
                        "errorCode": "Errorrule_888ef",
                        "errorCondition": "FieldFilled(content) and FieldNotFilled(size)",
                        "severity": "ERROR",
                        "errorMessage": [
                          {
                            "locale": "en",
                            "text": "Internal Error: If the content is filled, the size must be also filled."
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}