root = true

[**]
indent_style = tab
trim_trailing_whitespace = true
insert_final_newline = true

[*.{adoc,md}]
trim_trailing_whitespace = false

[*.{json,yaml}]
indent_style = space
indent_size = 2
insert_final_newline = false

# npm adds final newline on changing the file
[package.json]
insert_final_newline = true

[*.{xml,xsd,gradle,groovy}]
indent_style = space
indent_size = 4

[license_header.txt]
insert_final_newline = false
