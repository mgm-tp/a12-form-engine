{
	"extends": "@com.mgmtp.a12.devtools/tsconfig",
	"exclude": ["node_modules", "lib", "target"],
	"include": ["./src/**/*"],
	"compilerOptions": {
		"outDir": "./lib",
		"rootDir": "./src",
		"types": [
			"node",
			"mocha",
			"@com.mgmtp.a12.widgets/widgets-core/lib/@types/styled-components/index.d.ts"
		],
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force"
	}
}
