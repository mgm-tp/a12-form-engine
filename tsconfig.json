{
	"include": [
		"oxfmt.config.ts",
		"oxlint.config.ts",
		"./scripts/*.ts"
	],
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"module": "NodeNext",
		"lib": ["ESNext"],
		"strictNullChecks": true,
		"erasableSyntaxOnly": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"types": ["node"]
	}
}
