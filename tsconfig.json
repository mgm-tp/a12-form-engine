{
	"include": [
		".pnpmfile.mjs",
		"eslint.root.config.ts",
		"eslint.config.ts",
		"prettier.config.js",
		"./scripts/validateA12Peers.ts"
	],
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"module": "NodeNext",
		"lib": ["ESNext"],
		"strictNullChecks": true,
		"paths": {
			// eslint provides its own types, but some dependencies pull in @types/eslint, which causes conflicts
			// therefore we force type resolution here
			"eslint": ["./node_modules/eslint"]
		},
		"erasableSyntaxOnly": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"types": ["node"]
	}
}
