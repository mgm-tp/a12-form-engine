{
  "name": "@com.mgmtp.a12.formengine/formengine-devapp",
  "version": "39.0.1",
  "description": "Form Engine Devapp",
  "author": "mgm technology partners",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/client/config/index.ts"
  ],
  "scripts": {
    "clean": "git clean -fdX -- dist",
    "build": "node --run compile && rsbuild build -c rsbuild/rsbuild.config.ts",
    "compile": "tsc",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . --cache",
    "lint:fix": "node --run lint -- --fix",
    "lint:onlyErrors": "node --run lint -- --quiet",
    "start": "node --run start:mock",
    "start:mock": "rsbuild dev --env-mode mock -c rsbuild/rsbuild.config.ts",
    "start:services": "pnpm run \"/^start:services:.*/\"",
    "start:services:server": "gradle -b ./resources/server/build.gradle --console=plain clean runJar",
    "start:services:app": "rsbuild dev --env-mode services -c rsbuild/rsbuild.config.ts",
    "analyze": "rsbuild build --env-mode analyze -c rsbuild/rsbuild.config.ts",
    "preview": "rsbuild preview -c rsbuild/rsbuild.config.ts"
  },
  "//": "All regular devapp deps are listed as dev deps to skip them during workspace pnpm audit",
